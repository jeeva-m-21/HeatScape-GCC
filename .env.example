# Database & PostGIS
POSTGRES_DB=heatscape_db
POSTGRES_USER=heatscape_admin
POSTGRES_PASSWORD=heatscape_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://heatscape_admin:heatscape_secure_password@db:5432/heatscape_db

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Backend Configuration
ENVIRONMENT=development
CHENNAI_CRS=EPSG:32644
INTERCHANGE_CRS=EPSG:4326
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
