# HeatScape GCC - Frontend Environment Configuration
# Set these in your Vercel Project Settings > Environment Variables

# Backend REST API endpoint (pointing to your hosted FastAPI backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Live WebSocket telemetry endpoint (for real-time IoT sensors)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/telemetry
